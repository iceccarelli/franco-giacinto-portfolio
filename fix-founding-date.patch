From f22e73b8e0d7db8c805bc2973d75fbb320ee0002 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 29 Aug 2026 21:47:47 +0000
Subject: [PATCH] fix(schema): remove the invented foundingDate 2011 from the
 business schema
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Every page's LocalBusiness JSON-LD asserted foundingDate '2011'. There is
no founding year in data/company.ts — years: 15 is the only tenure figure —
and 2011 is the incorporation year of the unrelated, inactive federal
'Green Hardwood Flooring Inc.' that /ai.txt and /llms.txt now explicitly
disclaim. Asserting it in structured data invites exactly the entity merge
those surfaces deny, and contradicts the repo rule that no date the site
cannot source may be emitted. Removed; a founding year returns only from a
sourced field the owner writes into data/company.ts. Test added: the
business schema must emit no foundingDate and must not contain 2011.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KHjK8bGraQmiDKA2FxukGM
---
 lib/seo.ts                 | 10 +++++++++-
 tests/llms-surface.test.ts | 13 +++++++++++++
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/lib/seo.ts b/lib/seo.ts
index 50e9f59..0701b31 100644
--- a/lib/seo.ts
+++ b/lib/seo.ts
@@ -117,7 +117,15 @@ export function localBusinessLd() {
     telephone: company.phone,
     email: company.email,
     priceRange: company.priceRange,
-    foundingDate: "2011",
+    /*
+     * No foundingDate. data/company.ts deliberately carries no founding year —
+     * `years: 15` is the only tenure figure — and a previous version asserted
+     * foundingDate "2011" here, which is the incorporation year of the
+     * unrelated, inactive federal "Green Hardwood Flooring Inc." the machine
+     * surfaces explicitly disclaim. A founding year returns only if the owner
+     * writes a sourced field into data/company.ts; derive it from that, never
+     * from arithmetic on `years`. tests/llms-surface.test.ts enforces this.
+     */
     founder: { "@id": `${SITE_URL}/about#franco` },
     employee: { "@id": `${SITE_URL}/about#franco` },
     address: {
diff --git a/tests/llms-surface.test.ts b/tests/llms-surface.test.ts
index 3410a51..909faff 100644
--- a/tests/llms-surface.test.ts
+++ b/tests/llms-surface.test.ts
@@ -135,3 +135,16 @@ describe("price bands agree across surfaces", () => {
     );
   });
 });
+
+describe("no invented founding year", () => {
+  test("the business schema emits no foundingDate while data/company.ts has no sourced year", async () => {
+    const { localBusinessLd } = await import("@/lib/seo");
+    const json = JSON.stringify(localBusinessLd());
+    assert.ok(
+      !json.includes("foundingDate"),
+      "foundingDate is back in the LocalBusiness schema with no source in data/company.ts. " +
+        "2011 in particular is the dead federal namesake's incorporation year — see company.notToBeConfusedWith.",
+    );
+    assert.ok(!json.includes("2011"), "the year 2011 must not appear in the business schema");
+  });
+});
-- 
