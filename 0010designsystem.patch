+            >
+              <div className="w-[min(58rem,calc(100vw-3rem))] overflow-hidden rounded-xl border border-border bg-surface shadow-[var(--shadow-card)]">
+                <div className="border-b border-border bg-bg-warm/60 px-6 py-3">
