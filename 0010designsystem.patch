+                <div className={`grid gap-6 p-6 ${section.feature ? "grid-cols-4" : "grid-cols-3"}`}>
+                  {section.groups.map((group) => (
+                    <div key={group.heading}>
+                      <p className="text-[0.6875rem] font-semibold tracking-[0.14em] text-muted uppercase">
