+
+/* ──────────────────────────────────────────────────────────────────────────
+   Coverage map markers.
+
+   Leaflet's own `circleMarker` cannot pulse, carry a count, or be styled from
+   a stylesheet — it is an SVG element with presentation attributes. So the
+   markers are `divIcon`s and their entire appearance lives here, which also
+   means the palette follows the design tokens instead of being restated as
+   hex literals inside a component.
+
+   Status is encoded by SHAPE as well as colour: a solid disc is coverage, a
+   hollow ring is a worked example placed at municipality precision, and the
+   studio is a filled bullseye. Colour alone would fail anyone with a colour
+   vision deficiency, and would fail the legend's whole purpose.
+   ────────────────────────────────────────────────────────────────────────── */
+
+.gh-marker {
+  background: none;
+  border: 0;
+}
+
+.gh-marker__dot {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  border-radius: 9999px;
+  transform: translate(-50%, -50%);
+  box-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
+}
+
+.gh-marker--core .gh-marker__dot {
+  width: 14px;
+  height: 14px;
+  background: var(--color-primary, #1b3a2a);
+  border: 2px solid #fff;
+}
+
+.gh-marker--extended .gh-marker__dot {
+  width: 11px;
+  height: 11px;
+  background: var(--color-map-extended, #a8742a);
+  border: 2px solid #fff;
+}
+
+.gh-marker--studio .gh-marker__dot {
+  width: 18px;
+  height: 18px;
+  background: #fff;
+  border: 4px solid var(--color-primary, #1b3a2a);
+}
+
+/* A worked example: hollow, because the location is municipality-level and a
+   filled pin would imply a precision this data does not have. */
+.gh-marker--showcase .gh-marker__ring {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  width: 24px;
+  height: 24px;
+  border-radius: 9999px;
+  border: 3px solid var(--color-primary, #1b3a2a);
+  background: rgb(255 255 255 / 0.86);
+  transform: translate(-50%, -50%);
+  box-shadow: 0 1px 5px rgb(0 0 0 / 0.3);
+}
+
+.gh-marker--showcase .gh-marker__pulse {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  width: 24px;
+  height: 24px;
+  margin: -12px 0 0 -12px;
+  border-radius: 9999px;
+  background: var(--color-primary, #1b3a2a);
+  opacity: 0.55;
+  animation: gh-map-pulse 2400ms cubic-bezier(0, 0, 0.2, 1) infinite;
+}
+
+.gh-marker__count {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  width: 24px;
+  height: 24px;
+  transform: translate(-50%, -50%);
+  font: 600 11px/24px ui-sans-serif, system-ui, sans-serif;
+  color: var(--color-primary, #1b3a2a);
+  text-align: center;
+}
+
+@keyframes gh-map-pulse {
+  0% {
+    transform: scale(0.7);
+    opacity: 0.5;
+  }
+  70% {
+    transform: scale(2.3);
+    opacity: 0;
+  }
+  100% {
+    transform: scale(2.3);
+    opacity: 0;
+  }
+}
+
+/* A pulsing ring behind text is a migraine trigger and a vestibular one. */
+@media (prefers-reduced-motion: reduce) {
+  .gh-marker--showcase .gh-marker__pulse {
+    animation: none;
+    opacity: 0.18;
+    transform: scale(1.6);
+  }
+}
+
+/* Leaflet's popup, wearing the site's clothes rather than its own. */
+.gh-pop {
