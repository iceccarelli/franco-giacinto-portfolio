+  tier: "core" | "extended";
   blurb: string;
   housing: string;
   typical: string;
   jobs: string[];
 };
 
+/** The name to use in a <title>. Falls back to the full municipal name. */
+export function titleNameOf(city: City) {
+  return city.titleName ?? city.name;
