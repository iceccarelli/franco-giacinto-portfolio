# ---------------------------------------------------------------------------
# Lead delivery. Until RESEND_API_KEY is set, validated leads are still captured
# as structured JSON in the server log, prefixed GREEN_HARDWOOD_LEAD.
# Set these in Vercel → Settings → Environment Variables (Production + Preview).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@greenhardwood.ca
LEAD_FROM_EMAIL="Green Hardwood <leads@greenhardwood.ca>"

# ---------------------------------------------------------------------------
# IndexNow. Generate any 32-64 char hex string, save it as public/<key>.txt
# containing exactly that key, then `npm run indexnow` after each deploy.
# ---------------------------------------------------------------------------
INDEXNOW_KEY=
