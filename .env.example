# ---------------------------------------------------------------------------
# Lead delivery. Until RESEND_API_KEY is set, validated leads are still captured
# as structured JSON in the server log, prefixed GREEN_HARDWOOD_LEAD.
# Set these in Vercel → Settings → Environment Variables (Production + Preview).
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_TO_EMAIL=hello@greenhardwood.ca
LEAD_FROM_EMAIL="Green Hardwood <leads@greenhardwood.ca>"

# ---------------------------------------------------------------------------
# IndexNow. Generate any 32-64 char hex string, save it as public/<key>.txt
# containing exactly that key, then `npm run indexnow` after each deploy.
# ---------------------------------------------------------------------------
INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# Public site URL. Only set this to override Vercel's own production domain —
# for example to pin a staging deployment, or before a custom domain is added.
# Resolution order: NEXT_PUBLIC_SITE_URL > VERCEL_PROJECT_PRODUCTION_URL >
# localhost in dev > company.website.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Ask Green Hardwood assistant (/api/ask).
#
# Without a key the assistant still works: it answers verbatim from data/ with
# citations, deterministically, at zero cost. Setting a key adds a phrasing
# layer that reads more naturally on open-ended questions — the model is given
# ONLY the retrieved passages and falls back to the grounded reply on any error.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-5
