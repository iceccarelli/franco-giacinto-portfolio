+  {
+    id: "hickory",
+    name: "Hickory",
+    hardness: "1820 Janka",
+    janka: 1820,
+    bestFor: "Dogs, kids, mudrooms, rustic rooms",
+    tone: "Wild contrast, blond to dark",
