+  const unit = /sq ft/i.test(priceFrom)
+    ? ("square foot" as const)
+    : /per step|\/\s*step/i.test(priceFrom)
+      ? ("step" as const)
+      : /linear foot/i.test(priceFrom)
+        ? ("linear foot" as const)
+        : null;
