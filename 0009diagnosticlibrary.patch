+      <div className="mx-auto max-w-6xl px-4 sm:px-6">
+        <Breadcrumbs items={crumbs} />
+      </div>
+
+      <div className="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
+        <div className="rounded-xl bg-primary p-6 text-primary-fg sm:p-8">
